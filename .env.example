OPENAI_API_KEY=
# Leave DATABASE_URL unset for local dev (auto-anchored to <repo>/backend/.local/assistant.db).
# Set it for Supabase Postgres deployment.
# Prefer Supabase Direct connection or Session Pooler, with sslmode=require.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated extra allowed frontend origins.
FRONTEND_ORIGINS=
# Allows this project's Vercel production and preview URLs. Set blank to disable.
FRONTEND_ORIGIN_REGEX=https://enterprise-knowledge-assis[a-z0-9-]*\.vercel\.app
ADMIN_API_KEY=change-me
# Models: gpt-5.5 / gpt-5.4-mini for best quality; gpt-4.1-nano for lowest cost.
GEN_MODEL=gpt-5.5
UTILITY_MODEL=gpt-5.4-mini
EMBED_MODEL=text-embedding-3-large
EMBED_DIMS=3072
RATE_LIMIT=20/minute
MAX_QUESTION_CHARS=1200
RETRIEVAL_TOP_K=8
RERANK_TOP_K=6
RETRIEVAL_THRESHOLD=0.08
ENABLE_QUERY_REWRITE=true
ENABLE_LLM_RERANK=true
ENABLE_HYBRID=true
ENABLE_GROUNDEDNESS_GATE=true
# Multi-query / RAG-Fusion. Off by default (adds an LLM call + extra embeddings per query);
# enable once per-user corpora grow large. MULTI_QUERY_COUNT includes the original question.
ENABLE_MULTI_QUERY=false
MULTI_QUERY_COUNT=3
# Per-user auth (Phase 1). Off by default => single shared pool owned by the seed user.
# When true, /ask, /documents, /feedback and /ingest require a valid Supabase JWT and
# scope all data to that user. Prefer SUPABASE_URL or SUPABASE_JWKS_URL for modern
# Supabase ES256 tokens; SUPABASE_JWT_SECRET is the legacy HS256 fallback.
REQUIRE_AUTH=false
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
