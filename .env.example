OPENAI_API_KEY=
# Leave DATABASE_URL unset for local dev (auto-anchored to <repo>/backend/.local/assistant.db).
# Set it for Postgres deployment, e.g. postgresql://user:pass@host:5432/db
# DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_API_KEY=change-me
# Models: gpt-5.5 / gpt-5.4-mini for best quality; gpt-4.1-nano for lowest cost.
GEN_MODEL=gpt-5.5
UTILITY_MODEL=gpt-5.4-mini
EMBED_MODEL=text-embedding-3-large
EMBED_DIMS=3072
RATE_LIMIT=20/minute
MAX_QUESTION_CHARS=1200
RETRIEVAL_TOP_K=8
RERANK_TOP_K=6
RETRIEVAL_THRESHOLD=0.08
ENABLE_QUERY_REWRITE=true
ENABLE_LLM_RERANK=true
ENABLE_HYBRID=true
ENABLE_GROUNDEDNESS_GATE=true
# Optional bearer auth on /ask and /feedback (off by default).
REQUIRE_AUTH=false
API_AUTH_TOKEN=
