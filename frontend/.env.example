# Backend API base URL (Railway in production, local FastAPI in dev).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Auth (optional). Leave both blank to run anonymously against the shared
# seed pool. Set both to require sign-in and give each user their own documents.
# Find them in Supabase: Project Settings > API > Project URL and anon/public key.
VITE_SUPABASE_URL=
# Either key name works. Use the publishable key if your Supabase dashboard shows
# the newer "publishable key" naming instead of "anon public".
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
